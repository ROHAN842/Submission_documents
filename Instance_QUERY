az container exec \ 

  --resource-group "$RESOURCE_GROUP" \ 

  --name "$CONTAINER_NAME" \ 

  --exec-command "ls -lah /MCP/data/token.pickle" 

  

echo "" 

echo "=========================================" 

echo "✅ DEPLOYMENT COMPLETE!" 

echo "=========================================" 

echo "API Docs: http://${PRIVATE_IP}:8658/api/v1/email_intent_agent/docs" 

