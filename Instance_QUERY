  --resource-group "$RESOURCE_GROUP" \ 

  --name "$CONTAINER_NAME" \ 

  --image "${ACR_LOGIN_SERVER}/mcp-token:latest" \ 

  --registry-login-server "$ACR_LOGIN_SERVER" \ 

  --registry-username "$ACR_USERNAME" \ 

  --registry-password "$ACR_PASSWORD" \ 

  --os-type Linux \ 

  --ports 8658 \ 

  --cpu 1 \ 

  --memory 2 \ 

  --environment-variables \ 

    GMAIL_TOKEN_PATH="/MCP/data/token.pickle" \ 

    CREDENTIALS_PATH="/MCP/credentials" \ 

  --azure-file-volume-mount-path /MCP/data \ 

  --azure-file-volume-account-name "$STORAGE_ACCOUNT" \ 

  --azure-file-volume-account-key "$STORAGE_KEY" \ 

  --azure-file-volume-share-name gmail-tokens \ 

  --vnet "$VNET_NAME" \ 

  --subnet "$SUBNET_NAME" 

  

echo "✅ Container deployment initiated" 

sleep 15 

  

