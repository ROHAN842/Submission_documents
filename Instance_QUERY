#!/bin/bash 

  

echo "=========================================" 

echo "STEP 1: DELETE OLD CONTAINER INSTANCE" 

echo "=========================================" 

  

RESOURCE_GROUP="EA-AZ-DEV-AgenticAI_HI" 

OLD_CONTAINER_NAME="mcp-jarvis" 

  

az container delete \ 

  --resource-group "$RESOURCE_GROUP" \ 

  --name "$OLD_CONTAINER_NAME" \ 

  --yes 

  

echo "✅ Old container deleted" 

  

echo "" 

echo "=========================================" 

echo "STEP 2: BUILD DOCKER IMAGE" 

echo "=========================================" 

  

cd ~/Chinmay/JarvisAgent_2.0/Jarvis/MCP 

  

docker build -t mcp-token:latest . 

  

echo "✅ Image built" 

  

echo "" 

echo "=========================================" 

echo "STEP 3: PUSH TO ACR" 

echo "=========================================" 

  

az acr login --name hexawarejarvisacr 

  

ACR_LOGIN_SERVER="hexawarejarvisacr-cvhcdcdec3chawdg.azurecr.io" 

  

docker tag mcp-token:latest ${ACR_LOGIN_SERVER}/mcp-token:latest 

docker push ${ACR_LOGIN_SERVER}/mcp-token:latest 

  

echo "✅ Image pushed to ACR" 

  

echo "" 

echo "=========================================" 

echo "STEP 4: CREATE CONTAINER INSTANCE (PRIVATE + VNET)" 

echo "=========================================" 

  

RESOURCE_GROUP="EA-AZ-DEV-AgenticAI_HI" 

STORAGE_ACCOUNT="agenticai1" 

CONTAINER_NAME="mcp-jarvis" 

VNET_NAME="Vnet-AgenticAI_HI" 

SUBNET_NAME="Subnet2" 

  

ACR_LOGIN_SERVER="hexawarejarvisacr-cvhcdcdec3chawdg.azurecr.io" 

ACR_USERNAME="HexawareJarvisacr" 

ACR_PASSWORD=$(az acr credential show --name hexawarejarvisacr --query "passwords[0].value" -o tsv) 

  

STORAGE_KEY=$(az storage account keys list \ 

